{
  "name": "crusades.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsx tools/changelog.ts && tsc --noEmit && vite build",
    "changelog": "tsx tools/changelog.ts",
    "catalog-sql": "tsx tools/catalog-sql.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --target=es2022 --external:ws --external:zod --log-level=warning --outfile=server/dist/server.mjs",
    "server": "npm run build:server && node server/dist/server.mjs",
    "sim": "esbuild tools/headless.ts --bundle --platform=node --format=esm --target=es2022 --log-level=warning --outfile=node_modules/.cache/headless.mjs && node node_modules/.cache/headless.mjs",
    "schema-test": "node tools/schema-test.mjs supabase/schema.sql",
    "scout-test": "esbuild tools/scout-test.ts --bundle --platform=node --format=esm --target=es2022 --log-level=warning --outfile=node_modules/.cache/scout-test.mjs && node node_modules/.cache/scout-test.mjs",
    "stress": "esbuild tools/stress.ts --bundle --platform=node --format=esm --target=es2022 --external:ws --log-level=warning --outfile=node_modules/.cache/stress.mjs && node node_modules/.cache/stress.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "stripe": "^23.0.0",
    "three": "^0.170.0",
    "ws": "^8.22.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
