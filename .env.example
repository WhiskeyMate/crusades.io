# Copy to .env for local work. In production set these in Netlify:
# Site configuration > Environment variables. Never commit real values.

# --- Public (built into the page) -----------------------------------------
# Leave both empty to ship with no accounts at all.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Game server for online play (see docs/SERVER.md). Empty = no online play.
VITE_GAME_SERVER=

# --- Secret (functions only) ----------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One Stripe price id per Crown pack (see docs/STORE.md). A pack whose
# variable is unset is shown as "not on sale yet".
STRIPE_PRICE_PAGE=
STRIPE_PRICE_SQUIRE=
STRIPE_PRICE_KNIGHT=
STRIPE_PRICE_BARON=
STRIPE_PRICE_DUKE=
STRIPE_PRICE_KING=
# Set to "off" to opt out of Stripe Managed Payments (Stripe as seller of
# record). Left unset, each pack's product needs a tax code in Stripe.
STRIPE_MANAGED_PAYMENTS=
